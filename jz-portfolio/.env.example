# Live viewer count in the header (src/composables/useLivePresence.js).
# Copy this file to `.env.local` and fill both in; `.env.local` is gitignored.
#
# Supabase dashboard -> Project Settings -> API. The *anon* key, not the
# service_role key — anon is designed to ship to browsers and is baked into the
# built bundle either way. service_role must never leave a server.
#
# Both must also be set in Netlify (Site settings -> Environment variables),
# since VITE_ vars are read at build time, not at runtime.
#
# Leave them unset and the indicator simply never renders — nothing else on the
# site changes.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
