# Live viewer count in the header (src/composables/useLivePresence.js).
# Copy this file to `.env.local` and fill both in; `.env.local` is gitignored.
#
# Supabase dashboard -> Project Settings -> API Keys. Either the *publishable*
# key (sb_publishable_..., current) or the legacy *anon* key works; both are
# built to ship to browsers and are baked into the bundle regardless, so neither
# is a secret.
#
# Never the secret key (sb_secret_... / service_role). That one bypasses row
# level security and must not leave a server.
#
# VITE_SUPABASE_URL is the bare project URL — no /rest/v1/ suffix. supabase-js
# derives its own paths from it, including the wss:// realtime endpoint.
#
# Both must also be set in Netlify (Site settings -> Environment variables),
# since VITE_ vars are read at build time, not at runtime.
#
# Leave them unset and the indicator simply never renders — nothing else on the
# site changes.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
